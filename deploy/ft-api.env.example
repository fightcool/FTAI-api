# Server runtime configuration.
# Copy this file to /opt/ft-api/.env and replace every placeholder.

# PostgreSQL or another supported primary database.
SQL_DSN=postgresql://ft-api:replace-me@db.example.com:5432/ft-api?sslmode=require

# Redis connection used for shared state and caches.
REDIS_CONN_STRING=redis://:replace-me@redis.example.com:6379/0

# Must be long, random, and identical across all application nodes.
SESSION_SECRET=replace-with-at-least-32-random-characters

# Bind to loopback when nginx or another reverse proxy terminates TLS.
BIND_ADDRESS=127.0.0.1
PORT=3000

# Runtime settings.
TZ=Asia/Shanghai
GIN_MODE=release
NODE_NAME=ft-api-node-1
ERROR_LOG_ENABLED=true
BATCH_UPDATE_ENABLED=true
MEMORY_CACHE_ENABLED=true
SYNC_FREQUENCY=60

# Enable these when the public site is HTTPS and the trusted origins are known.
# SESSION_COOKIE_SECURE=true
# SESSION_COOKIE_TRUSTED_URL=https://api.ftai.cc
