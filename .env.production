# FT-API 生产环境配置
# 复制此文件到服务器 /opt/ft-api/.env 并修改相应配置

# 数据库连接（阿里云 RDS PostgreSQL）
SQL_DSN=postgres://ftai_movies:Liuwt312@pgm-bp16qxn7ffckeq563o.pg.rds.aliyuncs.com:5432/ftapi?sslmode=disable

# Redis 连接
REDIS_CONN_STRING=redis://172.17.0.1:6379

# 会话密钥
SESSION_SECRET=ftai_api_secret_2026

# 服务器地址（用于生成视频预览 URL）
SERVER_ADDRESS=https://api.ftai.cc

# 缓存配置
MEMORY_CACHE_ENABLED=true
SYNC_FREQUENCY=60

# 日志配置
ERROR_LOG_ENABLED=true

# 运行模式
GIN_MODE=release
PORT=3000

# 时区
TZ=Asia/Shanghai
